# =============================================================================
# Manager Development Dashboard — Environment Configuration
# =============================================================================
# Everything here is OPTIONAL. The app ships pre-connected to the "Management
# PMKT" Google Sheet, so a default build already reads live data. Use these
# variables only to override that (e.g. point at a different sheet, or force
# the bundled seed data). Copy this file to `.env` to use locally.
#
# All client-exposed variables MUST be prefixed with VITE_ (Vite requirement).
# -----------------------------------------------------------------------------

# Data source: "google-sheets" (default when a sheet id exists) or "seed".
# Set to "seed" to ignore the sheet and use the bundled demo data.
# VITE_DATA_SOURCE=google-sheets

# --- Google Sheets (read-only, public — no API key needed) -------------------
# The spreadsheet ID from the URL:
#   https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
# Defaults to the connected "Management PMKT" sheet when left unset.
# VITE_GOOGLE_SHEET_ID=1pNTvOYJ__opmJGUaiVe-fAFRzZwyt2jeqfBDfXha5-Y

# Optional: override tab/sheet names if yours differ from the defaults.
# Defaults: TeamMembers, Objectives, ActionItems, Meetings,
#           PerformanceKPIs, Assessments, ReadinessMetrics
# VITE_TAB_READINESS=ReadinessMetrics

# --- Write-back (optional) ---------------------------------------------------
# Apps Script Web App URL that lets the dashboard append rows to the sheet
# (e.g. "Add Member"). See apps-script/README.md. You can also paste this in the
# UI (Team Management → Sheet sync); set it here to make it the default for all
# users of the deployed site.
# VITE_SHEETS_WRITE_URL=https://script.google.com/macros/s/AKfy.../exec

# --- Cross-device sync (optional, recommended) -------------------------------
# When set, in-app data (campaign assignments, tasks, weekly updates, members,
# roles…) syncs across all devices via Supabase. Leave blank for local-only.
# See docs/DEVICE_SYNC.md for the 1-time Supabase setup (free).
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
