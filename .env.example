# =============================================================================
# Manager Development Dashboard — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values to connect a live data source.
# All client-exposed variables MUST be prefixed with VITE_ (Vite requirement).
#
# Leave everything blank to run on the bundled seed data (works out of the box).
# -----------------------------------------------------------------------------

# Which data source to use: "seed" (default) or "google-sheets"
VITE_DATA_SOURCE=seed

# --- Google Sheets (read-only, public CSV/gviz endpoint) ---------------------
# 1. Create one Google Sheet with one tab per entity (see docs/GOOGLE_SHEETS.md).
# 2. File > Share > "Anyone with the link" (Viewer).
# 3. Copy the spreadsheet ID from the URL:
#    https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
VITE_GOOGLE_SHEET_ID=

# Optional: override tab/sheet names if yours differ from the defaults.
# Defaults: TeamMembers, Objectives, Meetings, ActionItems,
#           PerformanceKPIs, Assessments, ReadinessMetrics
